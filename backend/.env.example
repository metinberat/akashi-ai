APP_NAME=Akashi AI / ABSOLUTE Engine
APP_VERSION=0.4.0-pre-astra

# mock runs without a model service. Use ollama for the local qwen setup.
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Required only when AI_PROVIDER or one of the model profiles uses gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Capability profiles hide concrete providers from clients. Empty values inherit AI_PROVIDER.
AKASHI_MODEL_FAST_PROVIDER=
AKASHI_MODEL_QUALITY_PROVIDER=
AKASHI_MODEL_REASONING_PROVIDER=
AKASHI_MODEL_VISION_PROVIDER=
# Empty text-profile names inherit the provider's default model.
# When Gemini is configured and VISION is otherwise empty, Core uses GEMINI_MODEL
# for one-shot screen/camera/image analysis. Set both VISION values to override it.
AKASHI_MODEL_FAST_NAME=
AKASHI_MODEL_QUALITY_NAME=
AKASHI_MODEL_REASONING_NAME=
AKASHI_MODEL_VISION_NAME=

# ComfyUI remains loopback-only; clients never connect to it directly.
COMFY_BASE_URL=http://127.0.0.1:8188
MAX_IMAGE_UPLOAD_BYTES=20971520

# Optional writable root used by packaged Desktop Core. Repository development
# defaults to backend/data. Do not point this at packaged/read-only resources.
AKASHI_DATA_DIR=

# Existing conversation data is preserved. New runtime/private stores are Git-ignored.
MEMORY_FILE=data/memory.json
MEMORY_HISTORY_LIMIT=20
MEMORY_SUMMARY_MAX_CHARS=4000
LONG_TERM_MEMORY_FILE=data/long_term_memory.json
TASK_FILE=data/tasks.json
UPLOAD_DIR=data/uploads
FILE_INDEX_FILE=data/file_index.json
DEVICE_FILE=data/devices.json
MAX_UPLOAD_BYTES=10485760

# wikipedia requires no key but upstream access may be blocked.
# duckduckgo uses Instant Answer topics (limited coverage, NOT full web search).
# searxng provides general search through your own configured instance.
RESEARCH_PROVIDER=duckduckgo
WIKIPEDIA_LANGUAGE=en
SEARXNG_BASE_URL=
RESEARCH_TIMEOUT_SECONDS=20

# MISS MINUTES uses dedicated private state, never user memory. Scheduled network
# discovery is opt-in; manual discovery remains available through the protected API.
INTELLIGENCE_FILE=data/private/intelligence.json
SCHEDULE_FILE=data/private/schedules.json
LIVE_STATE_FILE=data/private/live_interactions.json
COMPUTER_STATE_FILE=data/private/computer_sessions.json
VOICE_STATE_FILE=data/private/voice_sessions.json
PHONE_CALLS_FILE=data/private/phone_calls.json
MISS_MINUTES_ENABLED=false
MISS_MINUTES_TIMEZONE=Europe/Istanbul
MISS_MINUTES_DISCOVERY_MINUTES=360
MISS_MINUTES_BRIEF_MINUTES=1440

PAIRING_CODE_TTL_SECONDS=600
DEVICE_ONLINE_TTL_SECONDS=75

# Loopback-only Windows body bridge. Use the same random 32+ character value
# when starting desktop/agent. Never expose this token to a client bundle.
AKASHI_AGENT_URL=http://127.0.0.1:8765
AKASHI_AGENT_TOKEN=
AKASHI_AGENT_TIMEOUT=150
# Maximum observe-plan-act cycles per autonomous desktop task.
AKASHI_COMPUTER_MAX_STEPS=12
AUTONOMY_STATE_FILE=data/private/autonomy_tasks.json
AUTONOMY_SKILL_FILE=data/private/autonomy_skills.json
AUTONOMY_KNOWLEDGE_FILE=data/private/autonomy_knowledge.json
AKASHI_AUTONOMY_MAX_SUBGOALS=40
AKASHI_BROWSER_DEBUG_PORT=9222

# Optional approved repository used by "AKASHI projesini aç". The Windows
# agent still enforces AKASHI_AGENT_ALLOWED_ROOTS.
AKASHI_PROJECT_PATH=

# Required for all personal AI/data routes. Generate at least 32 random characters.
AKASHI_API_TOKEN=

# Exact browser/WebView/Desktop origins only. Add the deployed web origin explicitly.
AKASHI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,https://localhost,http://localhost,capacitor://localhost,akashi://app

# LiveKit telephony. Keep every credential server-side. The worker token is a
# separate random 32+ character secret used only between the LiveKit worker and Core.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

VERIMOR_SIP_SERVER=sip.verimor.com.tr
VERIMOR_SIP_USERNAME=
VERIMOR_SIP_PASSWORD=

AKASHI_PHONE_ENABLED=false
AKASHI_OUTBOUND_CALLS_ENABLED=false
AKASHI_PHONE_AGENT_NAME=akashi-phone
AKASHI_PHONE_WORKER_TOKEN=
AKASHI_PHONE_CORE_URL=http://127.0.0.1:8000

# Turkish-capable LiveKit Inference defaults. Set a Cartesia voice ID before
# enabling phone calls. These model choices can be changed without client builds.
AKASHI_PHONE_STT_MODEL=cartesia/ink-whisper
AKASHI_PHONE_STT_LANGUAGE=tr
AKASHI_PHONE_TTS_MODEL=cartesia/sonic-3
AKASHI_PHONE_TTS_VOICE=
AKASHI_PHONE_TTS_LANGUAGE=tr
## Computer Agent V2 / professional expertise (server-side, local storage)
AKASHI_AUTONOMY_LOCAL_FALLBACK=true
EXPERTISE_DB=data/private/expertise.sqlite3
