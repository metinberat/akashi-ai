# Fixed installed Python environment. No auto-install or external application auto-start.
FORM_PYTHON=
# Optional; defaults to Electron userData. Never use packaged resources for mutable state.
FORM_DATA_DIR=
# Model interpretation is optional. Local numeric/DCC workflows work without it.
FORM_REASONING_PROVIDER=ollama
FORM_REASONING_MODEL=qwen3:8b
FORM_EXTERNAL_MODELS_ENABLED=false
FORM_OLLAMA_URL=http://127.0.0.1:11434
FORM_VISION_PROVIDER=
FORM_VISION_MODEL=
FORM_GEMINI_API_KEY=
# Optional separately installed local shape SDK, NOT mandatory for FORM.
# Read its license first: generated output is excluded from FORM learning/datasets.
FORM_LOCAL_SHAPE_ENABLED=false
FORM_SHAPE_LICENSE_ACCEPTED=false
FORM_SHAPE_PYTHON=
FORM_SHAPE_SDK=
FORM_SHAPE_CHECKPOINT=
FORM_SHAPE_CONFIG=
