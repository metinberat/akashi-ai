{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "serve out -l 3100",
    "lint": "eslint",
    "test:api": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "mobile:sync": "npm run build && cap sync",
