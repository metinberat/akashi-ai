# Required for the loopback local API. Generate a random value of at least 32 characters.
AKASHI_AGENT_TOKEN=

# Semicolon-separated roots the local agent may inspect or open.
# Defaults to the current user's Desktop and Documents folders.
AKASHI_AGENT_ALLOWED_ROOTS=

# Optional private screenshot output folder. Defaults outside the repository.
AKASHI_AGENT_CAPTURE_DIR=

# The relay reads its paired device credential from this encrypted local file.
AKASHI_AGENT_CREDENTIAL_FILE=

# Optional local JSON registry of trusted projects/scripts and pinned package SHA256.
# Empty means project-script execution is disabled. See docs/security.md.
AKASHI_AGENT_SCRIPT_REGISTRY=
